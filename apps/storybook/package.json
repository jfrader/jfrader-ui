{
  "name": "@jfrader/storybook",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "storybook dev -p 6006",
    "build": "pnpm verify:docs && storybook build",
    "og:image": "node og/render.mjs",
    "test": "node --test scripts/measure-geometry.test.mjs && pnpm test:canvas && vitest run --project=storybook --project=design",
    "test:canvas": "node --experimental-strip-types --test ../../packages/ui/src/components/voice-orb/orb-painter.test.mjs",
    "test:browser": "node --test ../../packages/ui/src/components/image-compare/image-compare.browser.test.mjs ../../packages/ui/src/components/voice-orb/voice-orb.browser.test.mjs ../../packages/ui/src/components/command-palette/command-palette.browser.test.mjs ../../packages/ui/src/components/radial-menu/radial-menu.browser.test.mjs ../../packages/ui/src/components/share-access/share-access.browser.test.mjs ../../packages/ui/src/components/streaming-caret/streaming-caret.browser.test.mjs ../../packages/ui/src/components/booking-pill/booking-pill.browser.test.mjs",
    "verify:design": "vitest run --project=design --project=storybook --maxWorkers=2 design-assertions.test.ts photo-grid control-center share-access voice-recorder booking-pill logo-orbit radial-menu action-button action-morph multi-region-failover payment-flow card-stack game-chip",
    "typecheck": "tsc -p tsconfig.json --noEmit && pnpm verify:docs:examples",
    "verify:api": "node --test scripts/verify-styling-api.test.mjs && node scripts/verify-styling-api.mjs",
    "verify:docs": "pnpm verify:api && node ../../scripts/customization-inventory.mjs --check && node --test scripts/verify-docs.test.mjs scripts/verify-docs-usage.test.mjs && node scripts/verify-docs.mjs && node scripts/verify-docs-usage.mjs",
    "verify:docs:layout": "node scripts/verify-docs-layout.mjs",
    "audit:docs": "node scripts/audit-docs.mjs",
    "verify:docs:examples": "node scripts/verify-guide-examples.mjs",
    "verify:game-card": "node scripts/verify-game-card-edge.mjs"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@jfrader/tokens": "workspace:*",
    "@jfrader/ui": "workspace:*",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.6.1",
    "@storybook/addon-docs": "^10.6.1",
    "@storybook/addon-themes": "^10.6.1",
    "@storybook/addon-vitest": "^10.6.1",
    "@storybook/react-vite": "^10.6.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/browser": "^5.0.3",
    "@vitest/browser-playwright": "^5.0.3",
    "playwright": "^1.64.0",
    "react-hook-form": "^7.90.0",
    "storybook": "^10.6.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3",
    "@vitest/coverage-v8": "5.0.3"
  }
}
