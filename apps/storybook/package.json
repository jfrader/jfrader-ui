{
  "name": "@jfrader/storybook",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "storybook dev -p 6006",
    "build": "pnpm verify:docs && storybook build",
    "og:image": "node og/render.mjs",
    "test": "node --test scripts/measure-geometry.test.mjs && vitest run --project=storybook",
    "typecheck": "tsc -p tsconfig.json --noEmit && pnpm verify:docs:examples",
    "verify:docs": "node ../../scripts/customization-inventory.mjs --check && node --test scripts/verify-docs.test.mjs scripts/verify-docs-usage.test.mjs && node scripts/verify-docs.mjs && node scripts/verify-docs-usage.mjs",
    "verify:docs:layout": "node scripts/verify-docs-layout.mjs",
    "verify:docs:examples": "node scripts/verify-guide-examples.mjs",
    "verify:game-card": "node scripts/verify-game-card-edge.mjs"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@jfrader/tokens": "workspace:*",
    "@jfrader/ui": "workspace:*",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.6.1",
    "@storybook/addon-docs": "^10.6.1",
    "@storybook/addon-themes": "^10.6.1",
    "@storybook/addon-vitest": "^10.6.1",
    "@storybook/react-vite": "^10.6.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/browser": "^5.0.3",
    "@vitest/browser-playwright": "^5.0.3",
    "playwright": "^1.64.0",
    "react-hook-form": "^7.90.0",
    "storybook": "^10.6.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3",
    "@vitest/coverage-v8": "5.0.3"
  }
}
