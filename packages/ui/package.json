  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build --config vite.lib.config.ts && tsc -p tsconfig.build.json --emitDeclarationOnly --outDir dist/types",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepack": "pnpm build && node ../../scripts/flip-exports.mjs dist --package ui",
    "postpack": "node ../../scripts/flip-exports.mjs src --package ui"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@floating-ui/react": "^0.27.20",
    "@jfrader/tokens": "workspace:*",
