{
  "name": "@jfrader/styling",
  "version": "0.19.1",
  "description": "Shared Emotion styling seam for @jfrader/icons and @jfrader/ui.",
  "keywords": [
    "react",
    "emotion",
    "styling",
    "theming",
    "design-system"
  ],
  "homepage": "https://github.com/jfrader/jfrader-ui/tree/master/packages/styling#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jfrader/jfrader-ui.git",
    "directory": "packages/styling"
  },
  "license": "MIT",
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./css": "./src/css.ts",
    "./sx": "./src/sx.tsx",
    "./native-scrollbar": "./src/native-scrollbar.ts",
    "./theme": "./src/theme.ts",
    "./media": "./src/media.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "vite build --config vite.lib.config.ts && tsc -p tsconfig.build.json",
    "prepack": "pnpm build && node ../../scripts/flip-exports.mjs dist --package styling",
    "postpack": "node ../../scripts/flip-exports.mjs src --package styling"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@jfrader/tokens": "workspace:*"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@vitejs/plugin-react": "^6.1.2",
    "@types/react": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
