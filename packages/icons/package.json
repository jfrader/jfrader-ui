{
  "name": "@jfrader/icons",
  "version": "0.20.0",
  "description": "React icons and SVG icon components for @jfrader/ui.",
  "keywords": [
    "react",
    "icons",
    "svg",
    "design-system",
    "accessibility"
  ],
  "homepage": "https://github.com/jfrader/jfrader-ui/tree/master/packages/icons#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jfrader/jfrader-ui.git",
    "directory": "packages/icons"
  },
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./metadata": "./icons.json",
    "./sprite.svg": "./sprite.svg",
    "./paths.json": "./paths.json",
    "./svg-icon": {
      "types": "./src/svg-icon/index.ts",
      "import": "./src/svg-icon/index.ts"
    },
    "./*": {
      "types": "./src/generated/*.tsx",
      "import": "./src/generated/*.tsx"
    }
  },
  "scripts": {
    "generate": "tsx scripts/generate.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "pnpm generate && vite build --config vite.lib.config.ts && tsc -p tsconfig.build.json",
    "prepack": "pnpm build && node ../../scripts/flip-exports.mjs dist --package icons",
    "postpack": "node ../../scripts/flip-exports.mjs src --package icons"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@jfrader/styling": "workspace:*",
    "@jfrader/tokens": "workspace:*"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "@storybook/react-vite": "^10.6.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "tsx": "^4.23.15",
    "storybook": "^10.6.1"
  }
}
